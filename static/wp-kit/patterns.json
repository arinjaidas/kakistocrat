[{"title":"Kakistocrat: article skeleton","content":"<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"19px\",\"lineHeight\":\"1.6\"}},\"fontFamily\":\"newsreader\"} -->\n<p class=\"has-newsreader-font-family\" style=\"font-size:19px;line-height:1.6\">[Opening: the judgement in two or three sentences. What is happening, and what you conclude.]</p>\n<!-- /wp:paragraph --><!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"24px\",\"fontWeight\":\"600\"}},\"fontFamily\":\"ibm-plex-sans\"} -->\n<h2 class=\"wp-block-heading has-ibm-plex-sans-font-family\" style=\"font-size:24px;font-weight:600\">The evidence</h2>\n<!-- /wp:heading --><!-- wp:paragraph {\"fontFamily\":\"newsreader\"} -->\n<p class=\"has-newsreader-font-family\">[The numbers, with a source linked after each one.]</p>\n<!-- /wp:paragraph --><!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"24px\",\"fontWeight\":\"600\"}},\"fontFamily\":\"ibm-plex-sans\"} -->\n<h2 class=\"wp-block-heading has-ibm-plex-sans-font-family\" style=\"font-size:24px;font-weight:600\">The other side</h2>\n<!-- /wp:heading --><!-- wp:paragraph {\"fontFamily\":\"newsreader\"} -->\n<p class=\"has-newsreader-font-family\">[The strongest case against your judgement.]</p>\n<!-- /wp:paragraph --><!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"24px\",\"fontWeight\":\"600\"}},\"fontFamily\":\"ibm-plex-sans\"} -->\n<h2 class=\"wp-block-heading has-ibm-plex-sans-font-family\" style=\"font-size:24px;font-weight:600\">What would change my mind</h2>\n<!-- /wp:heading --><!-- wp:paragraph {\"fontFamily\":\"newsreader\"} -->\n<p class=\"has-newsreader-font-family\">[The specific data or event that would make you revise the judgement, and when it is due.]</p>\n<!-- /wp:paragraph --><!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"24px\",\"fontWeight\":\"600\"}},\"fontFamily\":\"ibm-plex-sans\"} -->\n<h2 class=\"wp-block-heading has-ibm-plex-sans-font-family\" style=\"font-size:24px;font-weight:600\">Sources</h2>\n<!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"14px\"}},\"fontFamily\":\"ibm-plex-sans\"} -->\n<p class=\"has-ibm-plex-sans-font-family\" style=\"font-size:14px\">[Source name, publisher, date, link]</p>\n<!-- /wp:paragraph -->"},{"title":"Kakistocrat: explore the data (dark card)","content":"<!-- wp:group {\"style\":{\"color\":{\"background\":\"#15171A\",\"text\":\"#FFFFFF\"},\"spacing\":{\"padding\":{\"top\":\"18px\",\"bottom\":\"18px\",\"left\":\"20px\",\"right\":\"20px\"},\"blockGap\":\"8px\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-text-color has-background\" style=\"color:#FFFFFF;background-color:#15171A;padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"11px\",\"fontWeight\":\"600\",\"letterSpacing\":\"0.1em\",\"textTransform\":\"uppercase\"},\"color\":{\"text\":\"#F0A39B\"},\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"fontFamily\":\"ibm-plex-mono\"} -->\n<p class=\"has-text-color has-ibm-plex-mono-font-family\" style=\"color:#F0A39B;margin-top:0;margin-bottom:0;font-size:11px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase\">Live data</p>\n<!-- /wp:paragraph --><!-- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"17px\",\"fontWeight\":\"600\",\"lineHeight\":\"1.3\"},\"color\":{\"text\":\"#FFFFFF\"},\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"fontFamily\":\"ibm-plex-sans\",\"level\":3} -->\n<h3 class=\"wp-block-heading has-text-color has-ibm-plex-sans-font-family\" style=\"color:#FFFFFF;margin-top:0;margin-bottom:0;font-size:17px;font-weight:600;line-height:1.3\">See the numbers behind this piece</h3>\n<!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"13.5px\",\"lineHeight\":\"1.5\"},\"color\":{\"text\":\"#C9CCD1\"},\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"4px\"}}},\"fontFamily\